{
    "version": "2.6.1",
    "description": "Open-source mod manager from Nexus Mods",
    "homepage": "https://www.nexusmods.com/about/vortex",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.6.1/vortex-setup-2.6.1.exe",
            "hash": "sha512:adcb9320c78e145af660cd606151080f1ac30d7264642d246bda794dc3eed32f5feb9872805776ca090d96a941950f5a8aba306d3cb6fe41412f7ffb6de8f53c",
            "installer": {
                "script": [
                    "$args = @('/S')",
                    "Start-Process \"$dir\\$fname\" -ArgumentList $args -Wait -Verb RunAs | Out-Null",
                    "Remove-Item \"$dir\\$fname\""
                ]
            }
        }
    },
    "checkver": {
        "github": "https://github.com/Nexus-Mods/Vortex"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v$version/vortex-setup-$version.exe"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
