{
    "version": "2.11.0",
    "description": "Open-source mod manager from Nexus Mods",
    "homepage": "https://www.nexusmods.com/about/vortex",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.11.0/vortex-setup-2.11.0.exe",
            "hash": "sha512:e8cbc90a393ebf773e9b1aa29eeaa8e09d5c07c77659ffe62e50231e105f0d680f61b14a84cedd13b5ba21ce71d3d582342dc6f65961851f9f6a1561409d4c62",
            "installer": {
                "script": [
                    "$args = @('/S')",
                    "Start-Process \"$dir\\$fname\" -ArgumentList $args -Wait -Verb RunAs | Out-Null",
                    "Remove-Item \"$dir\\$fname\""
                ]
            }
        }
    },
    "checkver": {
        "github": "https://github.com/Nexus-Mods/Vortex"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v$version/vortex-setup-$version.exe"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
