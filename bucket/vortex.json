{
    "version": "2.6.2",
    "description": "Open-source mod manager from Nexus Mods",
    "homepage": "https://www.nexusmods.com/about/vortex",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.6.2/vortex-setup-2.6.2.exe",
            "hash": "sha512:471f19e9f179528a5b68167f9ed52a9a2c78fe8ff62b90741d5615a4cda5a2615455d112e37d47337dbb5260dfe21d62b07e705a790ade485c1928d199281f61",
            "installer": {
                "script": [
                    "$args = @('/S')",
                    "Start-Process \"$dir\\$fname\" -ArgumentList $args -Wait -Verb RunAs | Out-Null",
                    "Remove-Item \"$dir\\$fname\""
                ]
            }
        }
    },
    "checkver": {
        "github": "https://github.com/Nexus-Mods/Vortex"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v$version/vortex-setup-$version.exe"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
